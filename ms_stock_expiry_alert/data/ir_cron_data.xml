<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_stock_expiry_check" model="ir.cron">
        <field name="name">Stock Expiry Alert - Check Expiry</field>
        <field name="model_id" ref="model_ms_stock_expiry_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_expiry()</field>

        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>

        <field name="active">True</field>
        <field name="priority">5</field>
    </record>

    <record id="ir_cron_stock_expiry_daily_digest" model="ir.cron">
        <field name="name">Stock Expiry Alert - Daily Digest</field>
        <field name="model_id" ref="model_ms_stock_expiry_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_daily_digest()</field>

        <field name="interval_number">1</field>
        <field name="interval_type">days</field>

        <field name="active">True</field>
        <field name="priority">10</field>
    </record>

</odoo>